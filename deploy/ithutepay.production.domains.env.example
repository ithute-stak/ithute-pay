# IthutePay production domains — non-secret deployment example.
# Copy these settings into your deployment secrets/configuration system.
# Do not commit real API keys, database passwords or encryption secrets.
ENVIRONMENT=production
DEBUG=false
EXPOSE_ERROR_DETAILS=false
PUBLIC_APP_URL=https://portal.pay.ithute.co.ls
PUBLIC_API_URL=https://api.pay.ithute.co.ls
PORTAL_APP_URL=https://portal.pay.ithute.co.ls/portal
CORS_ORIGINS=https://portal.pay.ithute.co.ls
TRUSTED_HOSTS=api.pay.ithute.co.ls
AUTH_COOKIE_SECURE=true
COOKIE_SAMESITE=lax

# Keep unreleased/uncertified Golink payment functionality disabled.
GOLINK_COLLECTIONS_ENABLED=false
GOLINK_RECONCILIATION_ENABLED=false

# Inject DATABASE_URL, SECRET_KEY, DATA_ENCRYPTION_KEY, M-PESA credentials,
# callback signing secrets, and other private config through a secret manager.
# The portal must use the API origin above with /api/v1 as appropriate.
